# ---- Data ------------------------------------------------------------------------------
# Where your Claude Code transcripts live (mounted read-only).
# Linux/macOS: ~/.claude/projects   Windows: C:/Users/<you>/.claude/projects
CLAUDE_PROJECTS_DIR=~/.claude/projects
POSTGRES_PASSWORD=change-me
WAMT_PORT=8787
WAMT_TIMEZONE=UTC                  # IANA name, used for daily charts, heatmap and digests
WAMT_SOURCE_NAME=local             # label for this machine's data
WAMT_SCAN_INTERVAL=5               # seconds between transcript scans

# ---- Privacy ---------------------------------------------------------------------------
WAMT_REDACT_SECRETS=true           # mask API keys, tokens, passwords and emails before storing
WAMT_STORE_PROMPTS=true            # false = keep only prompt length + category, never the text

# ---- Access ----------------------------------------------------------------------------
# WAMT_AUTH_PASSWORD=               # require a password for the dashboard
# WAMT_TRUST_PROXY_AUTH_HEADER=     # e.g. Remote-User when behind Authelia / oauth2-proxy
# WAMT_SECRET_KEY=                  # cookie signing key (auto-generated if unset)
# WAMT_METRICS_TOKEN=               # require "Authorization: Bearer <token>" on /metrics

# ---- Alerts ----------------------------------------------------------------------------
# WAMT_ALERT_URL=https://ntfy.sh/your-topic   # or a Discord / Slack / generic JSON webhook
# WAMT_ALERT_BLOCK_FACTOR=1.5                 # alert when a 5h block heads above 1.5x your median
# WAMT_ALERT_DIGEST_HOUR=9                    # daily digest at this local hour
# WAMT_PUBLIC_URL=https://wamt.example.com    # link included in alerts

# ---- Customization ---------------------------------------------------------------------
# WAMT_PRICING_FILE=/config/pricing.yaml
# WAMT_RULES_FILE=/config/rules.yaml
